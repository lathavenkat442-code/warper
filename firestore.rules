rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // All collections use a 'uid' field to identify the owner.
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function isNewDocOwner() {
      return isAuthenticated() && request.auth.uid == request.resource.data.uid;
    }

    function uidUnchanged() {
      return request.resource.data.uid == resource.data.uid;
    }

    // Generic validation for all entities
    function isValidEntity(data) {
      return data.uid is string && data.uid.size() > 0;
    }

    // Match all collections
    match /{collectionName}/{docId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if isAuthenticated() && isNewDocOwner() && isValidEntity(request.resource.data);
      allow update: if isAuthenticated() && isDocOwner() && uidUnchanged() && isValidEntity(request.resource.data);
      allow delete: if isAuthenticated() && isDocOwner();
    }
  }
}
